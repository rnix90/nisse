{
  "license": "GPL-2.0-or-later",
  "name": "ember",
  "version": 1,
  "status": "APPROVED by Bert 2026-11-12 (N-103): alert badge is a deep red with light text; the green badge keeps dark text",
  "notes": [
    "Ink, Paper and Ember are Bert's choices (decision 2026-11-02) and are pinned by a test.",
    "Every pairing listed under 'pairs' is checked by tools/palette: text 4.5 or more, shapes and control outlines 3.0 or more.",
    "Dividers are decorative and only promise 1.2.",
    "The dark set is the desktop shell. The light set is for document apps (mail, word processing, PDF, web).",
    "Paper text on an Ember fill is only 3.1, so Ember fills carry Ink text (on-accent).",
    "The red 'needs you' badge is a deep red (alert) with Paper text (on-alert), Bert's call at N-103. A deep red is only 2.3 to 3.0 against the dark surfaces, so a badge on surface or surface-2 carries a 1.5 px ring in alert-ring. Error text on dark uses alert-text, not alert."
  ],
  "dark": {
    "base":           {"hex": "#1b2330", "role": "Ink: window and desktop background"},
    "surface":        {"hex": "#222c3b", "role": "raised area: panels, cards"},
    "surface-2":      {"hex": "#2b3749", "role": "higher raised area: menus, inputs, hover rows"},
    "divider":        {"hex": "#354156", "role": "decorative lines between areas"},
    "outline":        {"hex": "#7a8699", "role": "control outlines and focus ring"},
    "text":           {"hex": "#f6f2e9", "role": "Paper: body text"},
    "text-muted":     {"hex": "#aab1bd", "role": "secondary text"},
    "accent":         {"hex": "#e0623f", "role": "Ember: accent fills, selection, buttons"},
    "accent-hover":   {"hex": "#e37353", "role": "accent fill, hovered"},
    "accent-pressed": {"hex": "#bd573c", "role": "accent fill, pressed"},
    "on-accent":      {"hex": "#1b2330", "role": "text and icons on an accent fill"},
    "accent-text":    {"hex": "#f28463", "role": "links and accent-colored text on dark"},
    "ok":             {"hex": "#4caf7a", "role": "success, unread completion (green badge)"},
    "warn":           {"hex": "#e5a93d", "role": "warning"},
    "info":           {"hex": "#5aa0e0", "role": "information"},
    "alert":          {"hex": "#d0243f", "role": "needs you: the red badge fill (deep red, light text)"},
    "alert-text":     {"hex": "#ff7a88", "role": "error and alert text and icons on dark"},
    "alert-ring":     {"hex": "#f6f2e9", "role": "1.5 px ring around the red badge on surface or surface-2"},
    "on-ok":          {"hex": "#1b2330", "role": "count text on the green badge"},
    "on-alert":       {"hex": "#f6f2e9", "role": "count text on the red badge (Paper)"}
  },
  "light": {
    "page":       {"hex": "#fffdf8", "role": "document page background"},
    "paper":      {"hex": "#f6f2e9", "role": "app chrome and sidebars next to a document"},
    "text":       {"hex": "#1b2330", "role": "Ink: document text"},
    "text-muted": {"hex": "#5d6573", "role": "secondary text"},
    "outline":    {"hex": "#7b8494", "role": "control outlines and focus ring"},
    "accent":     {"hex": "#bd4525", "role": "Ember darkened for light pages: links, accent fills"},
    "on-accent":  {"hex": "#fffdf8", "role": "text on a light-set accent fill"},
    "ok":         {"hex": "#2f7d4f", "role": "success"},
    "warn":       {"hex": "#8a5a00", "role": "warning"},
    "info":       {"hex": "#1f5fa8", "role": "information"},
    "alert":      {"hex": "#c0392b", "role": "errors"}
  },
  "pairs": [
    {"fg": "dark.text",       "bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "body text"},
    {"fg": "dark.text",       "bg": "dark.surface",   "min": 4.5, "kind": "text",  "use": "text on a panel"},
    {"fg": "dark.text",       "bg": "dark.surface-2", "min": 4.5, "kind": "text",  "use": "text in menus and inputs"},
    {"fg": "dark.text-muted", "bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "secondary text"},
    {"fg": "dark.text-muted", "bg": "dark.surface-2", "min": 4.5, "kind": "text",  "use": "secondary text in menus and inputs"},
    {"fg": "dark.accent-text","bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "links on the desktop"},
    {"fg": "dark.accent-text","bg": "dark.surface-2", "min": 4.5, "kind": "text",  "use": "links in menus"},
    {"fg": "dark.on-accent",  "bg": "dark.accent",    "min": 4.5, "kind": "text",  "use": "button label"},
    {"fg": "dark.on-accent",  "bg": "dark.accent-hover", "min": 4.5, "kind": "text", "use": "button label, hovered"},
    {"fg": "dark.on-ok",      "bg": "dark.ok",        "min": 4.5, "kind": "text",  "use": "green badge count"},
    {"fg": "dark.on-alert",   "bg": "dark.alert",     "min": 4.5, "kind": "text",  "use": "red badge count"},
    {"fg": "dark.ok",         "bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "success text"},
    {"fg": "dark.warn",       "bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "warning text"},
    {"fg": "dark.info",       "bg": "dark.base",      "min": 4.5, "kind": "text",  "use": "information text"},
    {"fg": "dark.alert-text",  "bg": "dark.base",     "min": 4.5, "kind": "text",  "use": "error text"},
    {"fg": "dark.alert-text",  "bg": "dark.surface-2", "min": 4.5, "kind": "text", "use": "error text in menus and inputs"},
    {"fg": "dark.outline",    "bg": "dark.base",      "min": 3.0, "kind": "shape", "use": "control outline"},
    {"fg": "dark.outline",    "bg": "dark.surface-2", "min": 3.0, "kind": "shape", "use": "control outline in menus"},
    {"fg": "dark.accent",     "bg": "dark.base",      "min": 3.0, "kind": "shape", "use": "accent icon or selection bar"},
    {"fg": "dark.ok",         "bg": "dark.surface-2", "min": 3.0, "kind": "shape", "use": "green badge on a raised area"},
    {"fg": "dark.alert",      "bg": "dark.base",      "min": 3.0, "kind": "shape", "use": "red badge on the base"},
    {"fg": "dark.alert-ring", "bg": "dark.surface-2", "min": 3.0, "kind": "shape", "use": "badge ring on a raised area"},
    {"fg": "dark.divider",    "bg": "dark.base",      "min": 1.2, "kind": "shape", "use": "divider line", "decorative": true},
    {"fg": "light.text",      "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "document text"},
    {"fg": "light.text",      "bg": "light.paper",    "min": 4.5, "kind": "text",  "use": "text on app chrome"},
    {"fg": "light.text-muted","bg": "light.page",     "min": 4.5, "kind": "text",  "use": "secondary text"},
    {"fg": "light.text-muted","bg": "light.paper",    "min": 4.5, "kind": "text",  "use": "secondary text on app chrome"},
    {"fg": "light.accent",    "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "links in a document"},
    {"fg": "light.accent",    "bg": "light.paper",    "min": 4.5, "kind": "text",  "use": "links on app chrome"},
    {"fg": "light.on-accent", "bg": "light.accent",   "min": 4.5, "kind": "text",  "use": "button label"},
    {"fg": "light.ok",        "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "success text"},
    {"fg": "light.ok",        "bg": "light.paper",    "min": 4.5, "kind": "text",  "use": "success text on app chrome"},
    {"fg": "light.warn",      "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "warning text"},
    {"fg": "light.info",      "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "information text"},
    {"fg": "light.alert",     "bg": "light.page",     "min": 4.5, "kind": "text",  "use": "error text"},
    {"fg": "light.alert",     "bg": "light.paper",    "min": 4.5, "kind": "text",  "use": "error text on app chrome"},
    {"fg": "light.outline",   "bg": "light.page",     "min": 3.0, "kind": "shape", "use": "control outline"}
  ]
}
