# The nisse system default for every new user (ledger N-108). Installed as /etc/xdg/kdeglobals, which the Plasma
# session reads before Fedora's kde-settings profile, so the keys below win and every other Fedora key still applies.
[General]
ColorScheme=NisseEmber
fixed=Fira Code,10,-1,5,50,0,0,0,0,0
font=Nunito,10,-1,5,50,0,0,0,0,0
menuFont=Nunito,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Nunito,8,-1,5,50,0,0,0,0,0
toolBarFont=Nunito,9,-1,5,50,0,0,0,0,0

[Icons]
Theme=breeze-dark

[KDE]
LookAndFeelPackage=org.nisse.desktop
widgetStyle=Breeze

[WM]
activeFont=Nunito,10,-1,5,50,0,0,0,0,0
