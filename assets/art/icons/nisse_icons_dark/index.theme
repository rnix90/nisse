[Icon Theme]
Name=nisse icons dark
Comment=The nisse gear, terminal and start icons over Breeze Dark; every other icon is Breeze Dark's
Inherits=breeze-dark
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
