<image>
  <!-- SPDX-License-Identifier: GPL-3.0-only -->
  <!-- The nisse live/install ISO. GPL-3.0-only because the iso type block and package set are copied from Fedora's
       GPL-3.0 liveinstall.xml (build/kiwi/fedora/COPYING). Fedora's KDE-Desktop-Live profile is not used because it pulls in
       fedora-release-kde and Fedora's volume id and publisher. This profile asks for the same building blocks
       (KDE-Desktop and BootCoreLive) and carries the live-install package set and ISO settings itself.
       Fedora's config.sh decides on the live KDE session by looking for "Live" and "KDE" in the selected
       profile names; KDE-Desktop supplies "KDE" and this profile's own name supplies "Live". -->
  <profiles>
    <profile name="Nisse-Live" description="nisse KDE Plasma live and install ISO">
      <requires profile="KDE-Desktop"/>
      <requires profile="BootCoreLive"/>
    </profile>
  </profiles>
  <preferences profiles="Nisse-Live" arch="x86_64">
    <type image="iso"
      publisher="nisse" volid="nisse-@PRODUCT@" application_id="nisse-@PRODUCT@"
      primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6" mediacheck="true"
      firmware="uefi" efiparttable="gpt" efifatimagesize="30" kernelcmdline="@KERNELCMDLINE@"
      fscreateoptions="-Efragments -C 1048576"
      >
      <bootloader name="grub2" grub_template="nisse/grub-x86.cfg.iso-template" console="console" timeout="10"/>
    </type>
    <bootloader-theme>nisse</bootloader-theme>
  </preferences>
  <!-- The release package that provides system-release and the nisse identity. -->
  <packages type="bootstrap" patternType="plusRecommended" profiles="Nisse-Live">
    <package name="nisse-release"/>
  </packages>
  <packages type="image" patternType="plusRecommended" profiles="Nisse-Live">
    <package name="nisse-release-common"/>
    <package name="nisse-branding"/>
    <package name="nisse-fonts-nunito"/>
    <package name="nisse-theme"/>
    <package name="nisse-wallpaper"/>
    <package name="nisse-cursors"/>
    <package name="nisse-icons"/>
    <package name="nisse-sounds"/>
    <package name="nisse-lookandfeel"/>
    <package name="nisse-defaults"/>
    <package name="nisse-hw"/>
    <package name="nisse-installer"/>
    <package name="nisse-snapshots"/>
    <package name="nisse-boot"/>
    <package name="nisse-update"/>
    <package name="nisse-sudo"/>
    <package name="nisse-choices"/>
    <package name="nisse-setup"/>
    <package name="nisse-avatars"/>
    <package name="nisse-firstboot"/>
    <package name="nisse-daemon"/>
    <package name="nisse-panel"/>
    <package name="nisse-plymouth"/>
    <package name="nisse-grub-theme"/>
    <ignore name="fedora-release"/>
    <ignore name="fedora-release-*"/>
    <ignore name="fedora-logos"/>
    <ignore name="generic-logos"/>
    <ignore name="plasma-setup"/>
    <ignore name="kde-settings-plasmalogin"/>
    <!-- The default apps (N-507, docs/default-apps.md; the same list as data in build/default-apps.txt, checked by a real dnf
         dry run in tests/build/test_image_apps.sh). kiwi turns an ignore into a dnf exclude, so a package that something
         hard-requires cannot be dropped here: it is kept and its launcher entries are hidden instead (see the "hide" lines). -->
    <ignore name="dragon"/>
    <ignore name="kmahjongg"/>
    <ignore name="kmines"/>
    <ignore name="kpat"/>
    <ignore name="krdc"/>
    <ignore name="krfb"/>
    <ignore name="neochat"/>
    <ignore name="setroubleshoot"/>
    <ignore name="gnome-abrt"/>
    <ignore name="abrt-gui"/>
    <ignore name="abrt-desktop"/>
    <ignore name="kdebugsettings"/>
    <ignore name="im-chooser"/>
    <ignore name="imsettings-plasma"/>
    <ignore name="kmouth"/>
    <ignore name="firefox"/>
    <ignore name="mediawriter"/>
    <ignore name="kde-partitionmanager"/>
    <ignore name="kfind"/>
    <ignore name="kwrite"/>
    <ignore name="khelpcenter"/>
    <ignore name="plasma-welcome"/>
    <ignore name="plasma-welcome-fedora"/>
    <package name="vlc"/>
    <package name="xournalpp"/>
    <package name="gparted"/>
    <package name="qalculate-qt"/>
    <package name="chromium"/>
    <package name="isoimagewriter"/>
    <package name="kate"/>
    <package name="moonlight-qt"/>
    <package name="sunshine"/>
  </packages>
  <!-- The live-install set, copied from Fedora's components/liveinstall.xml: the point of a live image is to install. -->
  <packages type="iso" patternType="plusRecommended" profiles="Nisse-Live">
    <file name="iso-esp-excludes.yaml" target="image/exclude_files_efifatimage.yaml"/>
    <namedCollection name="anaconda-tools"/>
    <package name="anaconda-install-env-deps"/>
    <package name="anaconda-live"/>
    <package name="aajohan-comfortaa-fonts"/>
    <package name="dracut-live"/>
    <package name="glibc-all-langpacks"/>
    <package name="isomd5sum"/>
    <package name="kernel"/>
    <package name="kernel-modules"/>
    <package name="kernel-modules-extra"/>
    <package name="livesys-scripts"/>
    <package name="btrfs-progs"/>
    <package name="udisks2-btrfs"/>
    <ignore name="device-mapper-multipath"/>
    <ignore name="fcoe-utils"/>
    <ignore name="gfs2-utils"/>
  </packages>
</image>
