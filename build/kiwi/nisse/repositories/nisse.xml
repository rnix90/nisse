<image>
  <!-- SPDX-License-Identifier: GPL-2.0-or-later -->
  <!-- Fedora's release repository only. Deliberately no "updates" repository: the image is a frozen
       snapshot of the release (Bert's decision, 2026-10-29). Fedora's own description lists updates too. -->
  <repository type="rpm-md" alias="fedora" sourcetype="metalink">
    <source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
      <signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
    </source>
  </repository>
  <!-- Our own packages, built into out/repo by tools/rpm/make-repo.sh. Unsigned for now; the lower priority
       number wins, so a Nisse package always beats a Fedora package of the same name. -->
  <repository type="rpm-md" alias="nisse" priority="90" package_gpgcheck="false" repository_gpgcheck="false">
    <source path="@NISSE_REPO@"/>
  </repository>
</image>
