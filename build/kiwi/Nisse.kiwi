<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<!-- Top-level kiwi description for Nisse. build/render-kiwi.sh copies the vendored Fedora description
     (build/kiwi/fedora) and this overlay into one directory, fills in the @...@ placeholders, and kiwi builds
     the profile Nisse-Live from there. See docs/superpowers/specs/2026-10-29-kiwi-build-design.md. -->
<image schemaversion="7.4" name="Nisse" displayname="Nisse">
  <description type="system">
    <author>Nisse contributors</author>
    <contact>https://github.com/rnix90/nisse</contact>
    <specification>Nisse, a Fedora-based distribution</specification>
  </description>
  <preferences>
    <version>@RELEASE@</version>
    <packagemanager>dnf5</packagemanager>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <release-version>@RELEASE@</release-version>
  </preferences>
  <include from="this://./nisse/repositories/nisse.xml"/>
  <include from="this://./components/common.xml"/>
  <include from="this://./components/boot.xml"/>
  <include from="this://./components/desktops/common.xml"/>
  <include from="this://./components/desktops/kde.xml"/>
  <include from="this://./components/users.xml"/>
  <include from="this://./nisse/components/nisse-live.xml"/>
  <packages type="bootstrap">
    <package name="filesystem"/>
  </packages>
</image>
