[Unit]
Description=Apply the nisse install choices
# After the first-boot wizard has recorded its answers, before anybody can log in.
After=local-fs.target nisse-setup.service
Before=display-manager.service
ConditionKernelCommandLine=!rd.live.image

[Service]
Type=oneshot
ExecStart=/usr/bin/nisse-choices apply --boot

[Install]
WantedBy=multi-user.target
