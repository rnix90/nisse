#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# nisse-apply-updates: the safe-apply flow (ledger N-308). Update the system with a way back.
#
#   nisse-apply-updates run [--reboot] [--tries N] [--dnf-arg ARG]...
#       1. refuse unless there is a way back (btrfs root with the snapper config, not live media, 10% free)
#       2. take a "before" snapshot (type pre)         -> the rollback target
#       3. nisse-hwroute: keep the hardware kernel and drivers this machine needs installed
#       4. dnf upgrade -y --refresh [ARG...]
#       5. take the paired "after" snapshot
#       6. state=pending-verify, and arm GRUB's boot counter on the "before" snapshot (nisse-boot arm)
#       7. reboot only if --reboot was given (a desktop is never restarted under open work; when the quiet updater may
#          reboot is the update policy, N-703)
#   nisse-apply-updates status      the state, as key=value lines
#   nisse-apply-updates verified    the health check (N-309) calls this once the new system is good: disarm GRUB, state idle
#   nisse-apply-updates reboot      reboot, only while an update waits to be verified
#
# The state file (/var/lib/nisse/update/state) is what N-309 (health check) and N-310 (watchdog) read:
#   state=idle | running | pending-verify | failed      snapshot=N (before)   post-snapshot=N   applied-at=EPOCH
#   changed=N   kernel-changed=yes|no   message=ONE LINE   last=verified|nothing-to-do
# A failure never arms anything and never reboots: an update that could not be armed has no way back.
#
# Test overrides (never set in production): NISSE_STATE_DIR, NISSE_SNAPPER, NISSE_DNF, NISSE_RPM, NISSE_BOOT_TOOL,
# NISSE_HWROUTE, NISSE_SYSTEMCTL, NISSE_SNAPPER_CONFDIR, NISSE_ROOT_FSTYPE, NISSE_FREE_PERCENT, NISSE_CMDLINE_FILE, NISSE_NOW,
# NISSE_MIN_FREE_PERCENT.
set -u

state_dir="${NISSE_STATE_DIR:-/var/lib/nisse/update}"
state_file="$state_dir/state"
snapper="${NISSE_SNAPPER:-/usr/bin/snapper}"
dnf="${NISSE_DNF:-/usr/bin/dnf}"
rpm="${NISSE_RPM:-/usr/bin/rpm}"
boot_tool="${NISSE_BOOT_TOOL:-/usr/bin/nisse-boot}"
hwroute="${NISSE_HWROUTE:-/usr/bin/nisse-hwroute}"
systemctl="${NISSE_SYSTEMCTL:-/usr/bin/systemctl}"
confdir="${NISSE_SNAPPER_CONFDIR:-/etc/snapper/configs}"
cmdline_file="${NISSE_CMDLINE_FILE:-/proc/cmdline}"
min_free="${NISSE_MIN_FREE_PERCENT:-10}"
cfg=root
default_tries=3

say() { echo "nisse-apply-updates: $*"; }
die() {
    echo "nisse-apply-updates: $*" >&2
    exit 1
}

is_number() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
    esac
    return 0
}

# Replace the state file in one step. Arguments are key=value lines.
write_state() {
    mkdir -p "$state_dir" || die "cannot create $state_dir"
    tmp="$state_file.new"
    : > "$tmp"
    for kv in "$@"; do
        printf '%s\n' "$kv" >> "$tmp"
    done
    mv -f "$tmp" "$state_file" || die "cannot write $state_file"
}

state_value() {
    [ -f "$state_file" ] || return 0
    sed -n "s/^$1=//p" "$state_file" | tail -1
}

current_state() {
    s="$(state_value state)"
    printf '%s\n' "${s:-idle}"
}

one_line() {
    printf '%s' "$*" | tr '\n\r' '  ' | cut -c1-200
}

# A failed run: record it, say it, stop. Nothing is armed and nothing reboots.
fail_run() {
    msg="$(one_line "$*")"
    write_state "state=failed" "snapshot=${pre:-}" "applied-at=${now}" "message=$msg"
    echo "nisse-apply-updates: failed: $msg" >&2
    [ -n "${pre:-}" ] && echo "nisse-apply-updates: the snapshot taken before the update is $pre" >&2
    exit 1
}

cmd_run() {
    reboot_after=no
    tries="$default_tries"
    extra="$(mktemp)" || die "cannot create a temporary file"
    trap 'rm -f "$extra"' EXIT
    while [ $# -gt 0 ]; do
        case "$1" in
            --reboot) reboot_after=yes; shift ;;
            --tries)
                [ $# -ge 2 ] || die "--tries needs a number from 1 to 9"
                tries="$2"
                shift 2
                ;;
            --dnf-arg)
                [ $# -ge 2 ] || die "--dnf-arg needs an argument"
                printf '%s\n' "$2" >> "$extra"
                shift 2
                ;;
            *) echo "nisse-apply-updates: unknown option: $1" >&2; exit 2 ;;
        esac
    done
    case "$tries" in
        [1-9]) ;;
        *) die "--tries must be a number from 1 to 9, not '$tries'" ;;
    esac
    now="${NISSE_NOW:-$(date +%s)}"
    pre=""

    # --- 1. a way back, or no update
    grep -qw rd.live.image "$cmdline_file" 2>/dev/null && die "this is live media: nothing to update"
    fstype="${NISSE_ROOT_FSTYPE:-$(stat -f -c %T / 2>/dev/null)}"
    [ "$fstype" = btrfs ] || die "the root file system is '$fstype', not btrfs: there would be no snapshot to go back to"
    [ -f "$confdir/$cfg" ] || die "there is no snapper root config yet (nisse-snapshot-setup makes it at first boot): no snapshot, no update"
    case "$(current_state)" in
        pending-verify) die "an update is pending verification (snapshot $(state_value snapshot)): verify it or roll it back first" ;;
    esac
    free="${NISSE_FREE_PERCENT:-}"
    if [ -z "$free" ]; then
        set -- $(stat -f -c '%a %b' / 2>/dev/null)
        [ "${2:-0}" -gt 0 ] 2>/dev/null && free=$(($1 * 100 / $2))
    fi
    if [ -n "$free" ] && [ "$free" -lt "$min_free" ]; then
        die "only ${free}% free on /: below ${min_free}% the snapshot cannot be made, and without a snapshot there is no way back"
    fi
    mkdir -p "$state_dir" || die "cannot create $state_dir"
    if command -v flock >/dev/null 2>&1; then
        exec 9> "$state_dir/lock"
        flock -n 9 || die "another run is in progress"
    fi
    [ "$(current_state)" = running ] && say "a previous run did not finish; carrying on"
    write_state "state=running" "started-at=$now"

    # --- 2. the way back
    before="$("$rpm" -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' 2>/dev/null | sort)"
    pre="$("$snapper" --no-dbus -c "$cfg" create -t pre -p -c number -d "safe-apply: before" -u "nisse=safe-apply" 2>/dev/null)" || pre=""
    if ! is_number "$pre"; then
        pre=""
        fail_run "snapper could not take the snapshot, so the update did not start"
    fi
    say "snapshot $pre taken: the way back"
    # the dnf hook would take a second pair around the same transaction
    export NISSE_SNAPSHOT_SKIP=1

    # --- 3. the hardware kernel and drivers
    if [ -x "$hwroute" ]; then
        out="$("$hwroute" 2>&1)" || fail_run "the hardware routing step failed: $out"
    fi

    # --- 4. the update
    set -- upgrade -y --refresh
    while IFS= read -r a; do
        set -- "$@" "$a"
    done < "$extra"
    out="$("$dnf" "$@" 2>&1)" || fail_run "dnf upgrade failed: $(printf '%s' "$out" | tail -2)"
    after="$("$rpm" -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' 2>/dev/null | sort)"
    printf '%s\n' "$before" > "$state_dir/before.tmp"
    changed="$(printf '%s\n' "$after" | grep -vxF -f "$state_dir/before.tmp")"
    rm -f "$state_dir/before.tmp"
    count="$(printf '%s\n' "$changed" | grep -c .)"

    if [ "$count" = 0 ]; then
        "$snapper" --no-dbus -c "$cfg" delete "$pre" >/dev/null 2>&1
        write_state "state=idle" "last=nothing-to-do" "applied-at=$now"
        say "nothing to update"
        return 0
    fi
    printf '%s\n' "$changed" > "$state_dir/changed.txt"
    kernel=no
    printf '%s\n' "$changed" | grep -q '^kernel-core-' && kernel=yes

    # --- 5. the "after" snapshot (a missing one is a pity, not a failure: the way back is the "before" one)
    post="$("$snapper" --no-dbus -c "$cfg" create -t post --pre-number "$pre" -p -c number -d "safe-apply: after" -u "nisse=safe-apply" 2>/dev/null)" || post=""
    is_number "$post" || post=""

    # --- 6. pending verification; GRUB is armed last
    write_state "state=pending-verify" "snapshot=$pre" "post-snapshot=$post" "applied-at=$now" "changed=$count" "kernel-changed=$kernel"
    if ! out="$("$boot_tool" arm --tries "$tries" "$pre" 2>&1)"; then
        fail_run "the update is applied but nisse-boot could not arm the boot fallback (no way back by itself, so no reboot): $out"
    fi
    say "update applied: $count packages changed (kernel changed: $kernel)"
    say "pending verification: if the next $tries boots never finish, GRUB starts snapshot $pre by itself"

    # --- 7. the reboot, only when asked
    if [ "$reboot_after" = yes ]; then
        say "rebooting"
        "$systemctl" reboot
    else
        say "a reboot is needed to finish and verify the update (nisse-apply-updates reboot)"
    fi
    return 0
}

cmd_status() {
    if [ -f "$state_file" ]; then
        cat "$state_file"
    else
        echo "state=idle"
    fi
}

cmd_verified() {
    [ "$(current_state)" = pending-verify ] || {
        say "nothing is pending verification"
        return 0
    }
    "$boot_tool" clear || die "nisse-boot clear failed, the update stays pending"
    write_state "state=idle" "last=verified" "applied-at=$(state_value applied-at)"
    say "update verified"
}

cmd_reboot() {
    [ "$(current_state)" = pending-verify ] || die "nothing is pending verification, so there is no reason to reboot"
    "$systemctl" reboot
}

case "${1:-}" in
    run)
        shift
        cmd_run "$@"
        ;;
    status) cmd_status ;;
    verified) cmd_verified ;;
    reboot) cmd_reboot ;;
    *)
        echo "usage: nisse-apply-updates run [--reboot] [--tries N] [--dnf-arg ARG]... | status | verified | reboot" >&2
        exit 2
        ;;
esac
