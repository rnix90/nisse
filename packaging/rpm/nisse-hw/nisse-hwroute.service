[Unit]
Description=Nisse hardware routing (install the kernel and drivers for this machine)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/nisse/hwroute.done
ConditionKernelCommandLine=!rd.live.image
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/nisse-hwroute
Restart=on-failure
RestartForceExitStatus=75
# Exit 1 means nisse-hwroute gave up (or hit an unexpected error): do not restart it until the next boot.
RestartPreventExitStatus=1
RestartSec=300

[Install]
WantedBy=multi-user.target
