[Unit]
Description=Fetch Claude Code from Anthropic
ConditionPathExists=!%h/.local/bin/claude
# Live media runs from RAM: do not download Claude Code there.
ConditionKernelCommandLine=!rd.live.image
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/nisse-fetch-claude
Restart=on-failure
RestartForceExitStatus=75
RestartSec=120

[Install]
WantedBy=default.target
