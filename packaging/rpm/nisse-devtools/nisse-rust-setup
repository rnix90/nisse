#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Sets Rust up for the person, once (ledger N-513, docs/dev-toolchain.md): the stable toolchain with rust-analyzer, clippy and rustfmt, into the
# home folder, through Fedora's rustup-init. Run by the cargo, rustc and rust-analyzer commands the first time any of them is used, or by hand.
# Rust is not on the image (it is large and moves quickly); this fetches it from rust-lang.org. NISSE_RUST_BIN is where rustup-init and curl are.
set -u
bin="${NISSE_RUST_BIN:-/usr/bin}"
cargo_home="${CARGO_HOME:-$HOME/.cargo}"

if [ -x "$cargo_home/bin/cargo" ]; then
    echo "nisse: Rust is already set up." >&2
    exit 0
fi

if ! "$bin/curl" -fsI --max-time 8 -o /dev/null https://static.rust-lang.org/dist/channel-rust-stable.toml; then
    echo "nisse: no network connection. Rust is fetched from rust-lang.org the first time you use it. Connect to a network and run the command again." >&2
    exit 1
fi

echo "nisse: setting up Rust (the stable toolchain) for you. This downloads it once, and takes a few minutes." >&2
if ! "$bin/rustup-init" -y --profile minimal --default-toolchain stable --no-modify-path -c rust-analyzer -c clippy -c rustfmt >&2; then
    echo "nisse: could not set up Rust. Check the messages above, then run the command again." >&2
    exit 1
fi
echo "nisse: Rust is ready." >&2
exit 0
